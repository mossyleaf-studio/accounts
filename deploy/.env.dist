IMAGE=docker.io/injust/mossyleaf-accounts
TAG=latest

PROXY_NETWORK=

PG_PASS=
AUTHENTIK_SECRET_KEY=

AUTHENTIK_WEB__BASE_URL=https://accounts.mossyleaf.studio
AUTHENTIK_ERROR_REPORTING__ENABLED=false

AUTHENTIK_BOOTSTRAP_EMAIL=
AUTHENTIK_BOOTSTRAP_PASSWORD=

AUTHENTIK_EMAIL__HOST=
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__TIMEOUT=10
AUTHENTIK_EMAIL__FROM=mossyleaf <accounts@mossyleaf.studio>

MOSSYDEW_CLIENT_SECRET=
MOSSYTRUNK_CLIENT_SECRET=
MOSSYLEAF_STUDIO_CLIENT_SECRET=
MUHMEAL_CLIENT_SECRET=
MUHMEAL_URL=
INJUST_CLIENT_SECRET=
INJUST_URL=

# Sign-in domain and sender of the other two contexts (mossyleaf keeps accounts.mossyleaf.studio and AUTHENTIK_EMAIL__FROM)
INJUST_ACCOUNTS_DOMAIN=accounts.injustmusic.com
INJUST_EMAIL_FROM=accounts@injustmusic.com
PERSONAL_ACCOUNTS_DOMAIN=accounts.duprat.cloud
PERSONAL_EMAIL_FROM=accounts@duprat.cloud
